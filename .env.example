# GEMINI_API_KEY: Required for server-side / Cloud Function Gemini AI API calls.
# Never expose this key to the client bundle.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ELEVENLABS_API_KEY: Required for server-side ElevenLabs natural voice synthesis.
# Never expose this key to the client bundle.
ELEVENLABS_API_KEY="MY_ELEVENLABS_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_FIREBASE_VAPID_KEY: Optional Web Push VAPID key for Firebase Cloud Messaging reminders.
VITE_FIREBASE_VAPID_KEY=""

# Email verification code delivery (configure either Resend OR SMTP for non-Google sign-up codes)
RESEND_API_KEY=""
EMAIL_FROM=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
